{
  "info": {
    "name": "Order & Invoice API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the requests top to bottom. **1. Log in** saves the token; **Create order** saves the order id used by the next requests.\n\nSet `baseUrl` to the live demo or to http://localhost:8000."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Log in",
      "item": [
        {
          "name": "Log in as admin",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "admin@demo.tn"
                },
                {
                  "key": "password",
                  "value": "demo1234"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"logged in\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "2. Catalog",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Low stock (5 or less)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?low_stock=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ],
              "query": [
                {
                  "key": "low_stock",
                  "value": "5"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Create product (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"LBN-500\",\n  \"name\": \"Lben 50 cl\",\n  \"unit_price\": \"1.200\",\n  \"tax_rate\": \"7\",\n  \"stock\": 48\n}"
            }
          }
        },
        {
          "name": "Receive a delivery (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/1/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "1",
                "stock"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delta\": 24,\n  \"note\": \"Supplier delivery\"\n}"
            }
          }
        },
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Société Carthage Digital\",\n  \"email\": \"compta@carthage-digital.tn\",\n  \"phone\": \"+216 70 100 200\",\n  \"tax_id\": \"1789456/C/M/000\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Orders & invoices",
      "item": [
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": 1,\n  \"items\": [\n    {\n      \"product_id\": 2,\n      \"quantity\": 2\n    },\n    {\n      \"product_id\": 7,\n      \"quantity\": 1\n    }\n  ],\n  \"note\": \"Table 4\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"order created\", () => pm.response.to.have.status(201));",
                  "const o = pm.response.json();",
                  "pm.collectionVariables.set(\"orderId\", o.id);",
                  "console.log(\"Invoice:\", o.invoice_url, \"QR page:\", o.public_url);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "List orders awaiting payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders?status=pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Invoice PDF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/invoice.pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}",
                "invoice.pdf"
              ]
            },
            "description": "Use *Send and Download* to save the PDF."
          }
        },
        {
          "name": "QR code PNG",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/qr.png",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}",
                "qr.png"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "4. Payments",
      "item": [
        {
          "name": "Pay online (returns pay_url, open it in a browser)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}",
                "payments"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"online\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const p = pm.response.json();",
                  "pm.collectionVariables.set(\"paymentId\", p.id);",
                  "console.log(\"Open this to pay:\", p.pay_url);"
                ]
              }
            }
          ]
        },
        {
          "name": "Or record a cash payment (closes the online checkout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}",
                "payments"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"cash\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const p = pm.response.json();",
                  "pm.collectionVariables.set(\"paymentId\", p.id);",
                  "console.log(\"Open this to pay:\", p.pay_url);"
                ]
              }
            }
          ]
        },
        {
          "name": "Payment status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/{{paymentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "{{paymentId}}"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "5. Cancel an order",
      "item": [
        {
          "name": "Create another order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": 1,\n  \"items\": [\n    {\n      \"product_id\": 2,\n      \"quantity\": 2\n    },\n    {\n      \"product_id\": 7,\n      \"quantity\": 1\n    }\n  ],\n  \"note\": \"Table 4\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"order created\", () => pm.response.to.have.status(201));",
                  "const o = pm.response.json();",
                  "pm.collectionVariables.set(\"orderId\", o.id);",
                  "console.log(\"Invoice:\", o.invoice_url, \"QR page:\", o.public_url);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel it (stock goes back)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}",
                "cancel"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "6. Reports",
      "item": [
        {
          "name": "Today's sales",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports/daily",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reports",
                "daily"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Sales on a given day",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports/daily?day=2026-11-17",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reports",
                "daily"
              ],
              "query": [
                {
                  "key": "day",
                  "value": "2026-11-17"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "CSV export (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports/orders.csv?start=2026-11-01&end=2026-11-30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reports",
                "orders.csv"
              ],
              "query": [
                {
                  "key": "start",
                  "value": "2026-11-01"
                },
                {
                  "key": "end",
                  "value": "2026-11-30"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"csv returned\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "7. Roles: the cashier account",
      "item": [
        {
          "name": "Log in as cashier",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "cashier@demo.tn"
                },
                {
                  "key": "password",
                  "value": "demo1234"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"logged in\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "CSV export as cashier → 403",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports/orders.csv?start=2026-11-01&end=2026-11-30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reports",
                "orders.csv"
              ],
              "query": [
                {
                  "key": "start",
                  "value": "2026-11-01"
                },
                {
                  "key": "end",
                  "value": "2026-11-30"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"cashiers cannot export\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "",
        "auth": {
          "type": "noauth"
        }
      }
    }
  ]
}