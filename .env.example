# Copy to .env and adjust. Every value has a sensible default for local use.

ENVIRONMENT=development
# Required in production: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me
# Where the API is reachable from the outside. QR codes and payment redirects point here.
# Leave empty on Vercel: the production URL is used automatically.
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://orders:orders@localhost:5432/orders
CORS_ORIGINS=*
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Printed on invoices
BUSINESS_NAME=Bureau Plus
BUSINESS_ADDRESS=45 Avenue de la Liberté, 1002 Tunis
BUSINESS_PHONE=+216 71 000 000
BUSINESS_TAX_ID=1234567/A/M/000
CURRENCY=TND
TIMEZONE=Africa/Tunis
DEFAULT_TAX_RATE=19
FISCAL_STAMP=1.000

# Online payments: mock (built-in sandbox), flouci, konnect or stripe
PAYMENT_PROVIDER=mock
# Flouci: keys from developers.flouci.com (the TEST APP's keys work with Flouci's test cards)
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_BASE_URL=https://api.sandbox.konnect.network/api/v2
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# A Vercel Schedule sends this as a Bearer token to /internal/reset-demo every day.
# Leave empty to disable the reset endpoint (e.g. for a real shop!).
CRON_SECRET=

# Load the demo business (two logins, menu, a week of sales) on first start
SEED_DEMO=true
DEMO_PASSWORD=demo1234
